APP_NAME="Olho"
APP_ENV=local
APP_KEY=base64:3jYk/pQvPDtALebar+y0Y4XuOl8iYSUbcpVhLP08oeE=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=investigacao_publica
DB_USERNAME=investigacao
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

PAYMENT_PROVIDER=fake
PIX_KEY_TYPE=cnpj
PIX_KEY=CONFIGURE_ME
PIX_RECEIVER_NAME=CONFIGURE_ME
PIX_RECEIVER_CITY=CONFIGURE_ME
PIX_EXPIRATION_MINUTES=30

# Administrador inicial (usado pelo comando `php artisan app:create-admin`).
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=secret

# Usuários de demonstração (usados apenas pelo `php artisan db:seed` / DemoUsersSeeder).
# Sem valor definido, o ambiente local usa a senha `password` para ambos.
DEMO_ADMIN_NAME="Administrador"
DEMO_ADMIN_EMAIL="admin@example.com"
DEMO_ADMIN_PASSWORD=secret
DEMO_USER_NAME="Usuário Demo"
DEMO_USER_EMAIL="usuario@example.com"
DEMO_USER_PASSWORD=secret
DEMO_CREDITS=500

# Execução de ferramentas OSINT reais (docs/21).
MAIGRET_DRIVER=process
MAIGRET_BINARY=maigret
MAIGRET_REQUEST_TIMEOUT=8
MAIGRET_PROCESS_TIMEOUT=45
MAIGRET_TOP_SITES=30
MAIGRET_MAX_CONNECTIONS=30
MAIGRET_EXTRACT=false

# Sherlock (ferramenta real).
SHERLOCK_DRIVER=process
SHERLOCK_BINARY=sherlock
SHERLOCK_REQUEST_TIMEOUT=6
SHERLOCK_PROCESS_TIMEOUT=45
SHERLOCK_SITES="GitHub,GitLab,BitBucket,Telegram,Twitter,Instagram,Reddit,Pinterest,TikTok,YouTube,Twitch,Vimeo,Medium,Spotify,SoundCloud,Docker Hub,Keybase,Gravatar,HackerNews"

# WhatsMyName (dataset público CC BY-SA 4.0).
WHATSMYNAME_DRIVER=http
WHATSMYNAME_DATABASE=/opt/whatsmyname/wmn-data.json
WHATSMYNAME_REQUEST_TIMEOUT=8
WHATSMYNAME_EXECUTION_TIMEOUT=45
WHATSMYNAME_CONCURRENCY=10
WHATSMYNAME_MAX_SITES=40
WHATSMYNAME_CATEGORIES=
WHATSMYNAME_SITES="GitHub (User),GitLab,Bitbucket,Codeberg,Codeforces,Kaggle,Telegram,Reddit,Pinterest,TikTok,Vimeo,Medium,Spotify,SoundCloud,Twitch,Instagram,Keybase,Gravatar,Behance,ArtStation,Flickr,Last.fm,Hacker News,Bluesky Username,Docker Hub (User),DeviantArt"
WHATSMYNAME_EXCLUDED_CATEGORIES="xx NSFW xx"

# Holehe (GPL-3.0): processo separado, sempre sem recuperação de senha
# (--no-password-recovery). Ver docs/30-holehe-integracao.md.
HOLEHE_DRIVER=process
HOLEHE_BINARY=holehe
HOLEHE_REQUEST_TIMEOUT=10
HOLEHE_PROCESS_TIMEOUT=45

APP_PORT=8080
# Execução OSINT real somente com APP_ENV=production
# (App\Sources\OsintMode): em local/testing/staging o modo efetivo é sempre
# mock, independentemente deste valor. Em produção, `mock` é o kill switch.
OSINT_MODE=real

PAYMENT_PROVIDER=fake

VITE_APP_NAME="${APP_NAME}"
